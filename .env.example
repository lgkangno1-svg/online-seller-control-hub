# Web app
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8787
WEB_DIST_PATH=./web/dist
# Trust CF-Connecting-IP only when this origin is reachable exclusively through the managed Cloudflare Tunnel/local host binding.
# Keep false for directly exposed origins or unknown reverse proxies.
TRUST_CLOUDFLARE_HEADERS=false

# Commercial account login.
# When SIGNUP_ENABLED=true, users can submit an email/password signup request.
# New accounts remain pending until an administrator approves them in SellerHub.
ACCOUNT_STORE_PATH=./data/accounts.json
ACCOUNT_SESSION_DAYS=7
SIGNUP_ENABLED=true

# Administrator bootstrap is intentionally NOT stored in this file.
# Production deployment accepts these only as one-time secrets:
# SELLERHUB_ADMIN_USERNAME=tnfwod
# SELLERHUB_ADMIN_PASSWORD=<secret>

# Legacy beta tokens remain optional for existing testers during migration.
# Preferred JSON shape: tester id -> account object. Never commit real tokens.
WEB_BETA_TOKENS={"tester1":{"token":"replace-with-a-long-random-token-001","tenantId":"demo","plan":"beta","enabled":true}}

# Public origin used for payment redirects, webhook registration and later Cloudflare domain.
# Example: https://seller.example.com
PUBLIC_BASE_URL=

# Paid plan / Toss Payments
# Leave the secret empty to keep checkout disabled. test_sk_* uses test mode; live_sk_* charges real money.
TOSS_PAYMENTS_SECRET_KEY=
# Server-to-server hosted checkout requires PAYMENT_STATUS_CHANGED webhook registration.
# Register: ${PUBLIC_BASE_URL}/api/webhooks/toss-payments in Toss Payments developer center.
# Keep false until the public HTTPS webhook has actually been registered and tested.
TOSS_PAYMENTS_WEBHOOK_ENABLED=false
# Suggested launch value only. Change before going live if pricing differs.
BILLING_PRO_30D_PRICE=29000
BILLING_PRO_DAYS=30
BILLING_STORE_PATH=./data/billing.json
# FREE plan limits are enforced by the server, not only hidden in the UI.
FREE_PRODUCT_LIMIT=20
FREE_MARKET_LIMIT=2

# Telegram (optional remote control surface)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_USER_ID=
TELEGRAM_TENANT_ID=demo

# Codex SDK authentication
CODEX_API_KEY=
CODEX_MODEL=
CODEX_WORKDIR=.

# Safety controls
# Natural-language price/stock/sales control remains simulation while true.
DRY_RUN=true
# Explicitly enable only control adapters that have passed live integration testing, e.g. coupang.
# Naver/Gmarket/Kakao/LotteON remain blocked until their delegated/agency approval paths are completed.
LIVE_MARKETS=
APPROVAL_TTL_SECONDS=600
# Real product creation is independently locked. Keep false until a tester intentionally enables it.
PRODUCT_REGISTRATION_ENABLED=false

# Marketplace credential encryption
# Generate a random 32-byte key and store only in the deployment secret manager (base64 encoded).
MARKET_CREDENTIALS_KEY=
MARKET_CREDENTIALS_PATH=./data/market-credentials.enc.json
# Delegated provider account identifiers such as Naver accountUid are also encrypted.
# Leave MARKET_LINKS_KEY empty to reuse MARKET_CREDENTIALS_KEY, or provide another base64 32-byte key in production secrets.
MARKET_LINKS_KEY=
MARKET_LINKS_PATH=./data/market-links.enc.json
# Fixed outbound server IP shown in the web UI for marketplaces that require IP allowlisting.
PUBLIC_EGRESS_IP=

# Operator-only commercial marketplace credentials.
# Never ask end users to provide these values and never commit production values.
# Gmarket seller-tool mode: SellerHub's approved ESM master credentials sign JWTs;
# each tenant only supplies/maps their own Gmarket seller ID.
GMARKET_OPERATOR_MASTER_ID=
GMARKET_OPERATOR_SECRET_KEY=
GMARKET_OPERATOR_ISSUER=
# Kakao agency mode: SellerHub owns the approved agency Admin App Key;
# each tenant only supplies the seller REST API key/channel IDs.
KAKAO_OPERATOR_ADMIN_APP_KEY=
# Naver Commerce Solution delegated onboarding (future production path) must use
# operator-owned solution/application configuration, not per-seller Client Secrets.
NAVER_SOLUTION_ID=
# PEM text may be stored directly, with literal \n escapes, or as base64:<base64-encoded-pem>.
NAVER_SOLUTION_PUBLIC_KEY=
NAVER_COMMERCE_CLIENT_ID=
NAVER_COMMERCE_CLIENT_SECRET=

# Runtime data. Keep every mutable file inside ./data so Docker rebuilds do not erase seller state.
PRODUCT_CATALOG_PATH=./data/products.json
REGISTRATION_LEDGER_PATH=./data/registration-ledger.json
AUDIT_LOG_PATH=./data/audit.jsonl
# Authentication/security telemetry stores only fingerprints of identifiers/network sources and rotates at 5 MiB.
SECURITY_AUDIT_LOG_PATH=./data/security-audit.jsonl
FEEDBACK_LOG_PATH=./data/feedback.jsonl

# LOTTEON
# Connection verification works without this. Set the exact product-create path from the seller's current OpenAPI specification before enabling LOTTEON product registration.
LOTTEON_PRODUCT_REGISTER_PATH=
