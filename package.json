{
  "name": "online-seller-control-hub",
  "version": "0.4.0",
  "private": true,
  "description": "Web + Telegram + Codex control plane for multi-market seller operations",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "check": "npm run typecheck && npm test && npm run web:typecheck",
    "build": "npm run check && npm run web:build",
    "install:all": "npm install && npm --prefix web install",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:typecheck": "npm --prefix web run typecheck"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.154.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.6.1",
    "grammy": "^1.38.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
